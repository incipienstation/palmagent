{
  "name": "@palmagent/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Palmagent runtime server for normalized agent events, durable task state, SSE, and REST control.",
  "scripts": {
    "contracts": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "contracts:live": "node --import tsx scripts/adapter-live-smoke.mjs",
    "dev": "tsx src/server.ts",
    "runner": "tsx src/runner-daemon.ts",
    "smoke": "node scripts/runtime-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@palmagent/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.1",
    "better-sqlite3": "^13.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
