{
  "name": "@palmagent/daemon",
  "root": "apps/palmagentd",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/build-daemon.mjs" },
      "inputs": ["default", "{workspaceRoot}/Cargo.toml", "{workspaceRoot}/Cargo.lock", "{workspaceRoot}/rust-toolchain.toml", "{workspaceRoot}/package.json", "{workspaceRoot}/scripts/build-daemon.mjs", { "runtime": "git rev-parse HEAD" }],
      "outputs": ["{workspaceRoot}/build/daemon"]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "commands": ["cargo fmt --all --check", "cargo clippy --workspace --all-targets --locked -- -D warnings", "cargo test --workspace --locked"], "parallel": false },
      "cache": false
    }
  }
}
