{
  "name": "@palmagent/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Palmagent's mobile-first installable client for agent dispatch over SSE and REST.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.fixtures.json",
    "test:e2e": "vite build && playwright test",
    "test:e2e:update": "vite build && playwright test --update-snapshots",
    "test:sw-update": "vite build && node scripts/test-sw-update.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@palmagent/shared": "workspace:*",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-toggle-group": "^1.1.12",
    "@simplewebauthn/browser": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decode-named-character-reference": "^1.3.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.13.7",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.13",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.3.0"
  }
