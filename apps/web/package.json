{
  "name": "@palmagent/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Palmagent's mobile-first installable client for agent dispatch over SSE and REST.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.fixtures.json",
    "test:e2e": "vite build && node scripts/run-e2e.mjs",
    "test:e2e:update": "vite build && node scripts/run-e2e.mjs --update-snapshots",
    "test:sw-update": "vite build && node scripts/test-sw-update.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@palmagent/shared": "workspace:*",
    "@radix-ui/react-dismissable-layer": "^1.2.1",
    "@shadcn/react": "^0.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decode-named-character-reference": "^1.3.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "phaser": "3.90.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.13",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@palmagent/server": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
