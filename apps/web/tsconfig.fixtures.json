{
  // Type-check the e2e mock fixtures against @palmagent/shared. fixtures.mjs
  // is plain .mjs (the mock server imports it directly) so it's outside the app
  // tsconfig, but its JSDoc `@type` annotations let checkJs verify every fake row
  // really matches the wire shapes (TaskState, Routine, RoutineRun, …). Wired into
  // the web `typecheck` script so drift fails the gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": []
  },
  "include": ["tests/fixtures.mjs"],
  "exclude": []
}
