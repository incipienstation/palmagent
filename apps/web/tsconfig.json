{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser app: override the base's NodeNext/ES2022-only setup for a
    // bundler (Vite) + DOM + JSX target. We only ever `import type` from
    // @palmagent/shared (all its exports are types), so esbuild erases
    // those imports — tsc still resolves them here via bundler resolution.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    // shadcn-style imports: "@/components/ui/button" etc. (mirrored in vite.config.ts)
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // sw.ts runs in the SW global scope (WebWorker lib); its globals conflict
  // with DOM's, so it typechecks separately via tsconfig.sw.json.
  "exclude": ["src/sw.ts"]
}
