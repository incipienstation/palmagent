{
  "preserveHost": true,
  "publicHttpsRequired": true,
  "cacheApi": false,
  "maxBodyBytes": 48000000,
  "sse": {
    "path": "/api/stream",
    "buffering": false,
    "readTimeoutSeconds": 3600
  },
  "websocket": {
    "pathPattern": "/api/terminals/:id/stream",
    "upgrade": true,
    "idleTimeoutSeconds": 60
  },
  "perClientLimits": {
    "authRequestsPerSecond": 5,
    "authBurst": 10,
    "apiRequestsPerSecond": 20,
    "apiBurst": 40,
    "apiConnections": 30,
    "terminalConnections": 16
  }
}
